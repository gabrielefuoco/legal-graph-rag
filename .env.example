# Docker (docker compose build)
# Indice delle wheel di PyTorch dentro l'immagine. Default: CUDA (host con NVIDIA).
# Host senza GPU (es. server Ubuntu): https://download.pytorch.org/whl/cpu
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# LLM Provider: "ollama" per esecuzione locale, "openrouter" per API cloud
LLM_PROVIDER=ollama

# LLM & Embedding (Local Ollama)
# Usa http://localhost:11434 per run locale, http://ollama:11434 per run dentro Docker
QWEN3_ENDPOINT=http://localhost:11434
EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b
GENERATIVE_MODEL_NAME=qwen3.5:4b
EMBEDDING_DIMENSIONS=1024

# OpenRouter (attivo se LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=qwen/qwen3.5-9b

# Reranker
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
# "local" = CrossEncoder (~1.2 GB VRAM, ~3s/query) | "llm" = reranking listwise via OpenRouter
RERANKER_BACKEND=local
# RERANKER_LLM_MODEL=qwen/qwen3.5-9b

# Tuning (opzionali — decommentare per override)
# TESEO_DENSE_THRESHOLD=0.55
# GENERATOR_NUM_CTX=4096
# SUPERVISOR_NUM_CTX=16384
#
# Soglia stuffing diretto vs map-reduce. Il map-reduce scarta informazione: misurato ~-4pp
# di similarità semantica sul dataset di valutazione (contesto medio ~15.000 char).
# Con provider cloud (openrouter) tenere alto: 64000 copre ~tutte le query.
# Con Ollama locale e finestre piccole (GENERATOR_NUM_CTX=4096) tenere basso.
# GENERATOR_STUFF_THRESHOLD=64000
#
# Prefisso di istruzione sulle SOLE query di embedding (nessuna re-indicizzazione).
# Vuoto per disabilitare. Applicato solo ai modelli di embedding qwen3.
# EMBEDDING_QUERY_INSTRUCTION=Instruct: Dato un quesito giuridico, recupera le disposizioni normative e i passaggi giurisprudenziali che rispondono alla domanda.
# Query: 
#
# Profondità del retrieval per canale e soglia minima di similarità vettoriale (Fase 4)
# RAG_TOP_K=15
# RAG_VECTOR_MIN_SCORE=0.3

# --- GraphRAG production configuration (verified on the three question classes) ---
# Reference resolution + precision knobs that make the graph add without displacing:
#   named references  : baseline 0%   -> graph 100%
#   multi-hop         : baseline 5%   -> graph 50%
#   text-sufficient   : baseline 100% -> graph 100% (no regression)
TESEO_DENSE_THRESHOLD=0.60
TESEO_MAX_CONCEPTS=3
CITATION_EXPANSION_LIMIT=10
CITATION_EXPANSION_PER_ACT=3
CITATION_HOP_SOURCE_TOP_K=5
PRIORITY_BASE_CHUNKS=6
RESOLVE_QUERY_CITATIONS=true
GRAPH_METADATA_IN_CONTEXT=false
