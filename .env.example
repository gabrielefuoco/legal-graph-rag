# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# LLM Provider: "ollama" per esecuzione locale, "openrouter" per API cloud
LLM_PROVIDER=ollama

# LLM & Embedding (Local Ollama)
# Usa http://localhost:11434 per run locale, http://ollama:11434 per run dentro Docker
QWEN3_ENDPOINT=http://localhost:11434
EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b
GENERATIVE_MODEL_NAME=qwen3.5:4b
EMBEDDING_DIMENSIONS=1024

# OpenRouter (attivo se LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=qwen/qwen3.5-9b

# Reranker
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B

# Tuning (opzionali — decommentare per override)
# TESEO_DENSE_THRESHOLD=0.55
# GENERATOR_NUM_CTX=4096
# SUPERVISOR_NUM_CTX=16384
